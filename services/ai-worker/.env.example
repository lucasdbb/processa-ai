# ==============================================================================
# AI Worker (AI Jobs API) - Variáveis de Ambiente
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development

# Auth (token para comunicação interna)
AI_WORKER_INTERNAL_TOKEN=troque-por-um-token-forte

# Redis
REDIS_URL=redis://localhost:6379/0
JOBS_QUEUE_KEY=jobs
JOB_STATUS_TTL_S=86400

# n8n (Workflow Engine)
N8N_BASE_URL=http://localhost:5678
N8N_CNIS_WORKFLOW_ID=seu-workflow-id
N8N_FILE_FIELD_NAME=data
N8N_AUTH_USER=
N8N_AUTH_PASSWORD=
N8N_TIMEOUT_S=120

# Callback URL (usado pelo worker para notificar a API após job concluído)
AI_WORKER_CALLBACK_BASE_URL=http://localhost:8001

# Supabase (para storage de outputs)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_OUTPUTS_BUCKET=ai-outputs

# Database (Alembic migrations)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require
