# Server
HOST=0.0.0.0
PORT=8003
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/processa_ai

# Redis
REDIS_URL=redis://localhost:6379/2

# Internal Auth (comunicacao entre gateway e office-api)
OFFICE_API_INTERNAL_TOKEN=troque-por-um-token-seguro

# Google OAuth
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/office/calendar/callback

# Encryption (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=sua-chave-fernet-base64

# Supabase (para storage de arquivos, se necessario)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Webhooks (URL publica para receber notificacoes do Google)
WEBHOOK_BASE_URL=https://api.seudominio.com
