# ==============================================================================
# Worker (Job Processor) - Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env ou use o .env global na raiz do projeto.
# ==============================================================================

# ==============================================================================
# DATABASE
# ==============================================================================
# Conexão direta PostgreSQL para persistir status dos jobs
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require

# ==============================================================================
# SUPABASE
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_OUTPUTS_BUCKET=supabase-outputs

# ==============================================================================
# REDIS (Job Queue)
# ==============================================================================
REDIS_URL=redis://redis:6379/0
JOBS_QUEUE_KEY=jobs
JOB_STATUS_TTL_S=86400

# ==============================================================================
# N8N INTEGRATION (AI Jobs)
# ==============================================================================
N8N_BASE_URL=http://n8n:5678
N8N_CNIS_WORKFLOW_ID=seu-workflow-id
N8N_FILE_FIELD_NAME=data
N8N_AUTH_USER=
N8N_AUTH_PASSWORD=
N8N_TIMEOUT_S=120

# ==============================================================================
# GOOGLE INTEGRATION (Office Jobs)
# ==============================================================================
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Encryption key para tokens Google (mesma do backend)
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=sua-chave-fernet-base64

# ==============================================================================
# CALLBACK
# ==============================================================================
# URL do backend para enviar updates de progresso dos jobs
AI_WORKER_CALLBACK_BASE_URL=http://backend:8000
PORT=8001
