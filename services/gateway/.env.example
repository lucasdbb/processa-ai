# ==============================================================================
# API Gateway - Variáveis de Ambiente
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Supabase (para autenticação de usuários)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Microserviços - URLs e Tokens
CORE_API_BASE_URL=http://localhost:8004
CORE_API_INTERNAL_TOKEN=troque-por-um-token-forte

AI_WORKER_BASE_URL=http://localhost:8001
AI_WORKER_INTERNAL_TOKEN=troque-por-um-token-forte

CALC_ENGINE_BASE_URL=http://localhost:8002
CALC_ENGINE_INTERNAL_TOKEN=troque-por-um-token-forte

OFFICE_API_BASE_URL=http://localhost:8003
OFFICE_API_INTERNAL_TOKEN=troque-por-um-token-forte

BILLING_API_BASE_URL=http://localhost:8005
BILLING_API_INTERNAL_TOKEN=troque-por-um-token-forte

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Timeouts (em segundos)
UPSTREAM_TIMEOUT_S=300
