{
  "name": "processa-ai-monorepo",
  "version": "1.0.0",
  "description": "Monorepo para o Processa AI - Plataforma de cálculos trabalhistas e IA",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@processa-ai/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "install-all": "npm install --workspaces",
    "frontend:dev": "npm run dev --workspace=@processa-ai/frontend",
    "frontend:build": "npm run build --workspace=@processa-ai/frontend",
    "frontend:start": "npm run start --workspace=@processa-ai/frontend",
    "start": "npm run start --workspace=@processa-ai/frontend",
    "backend:dev": "cd apps/backend && uv run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:install": "cd apps/backend && uv sync",
    "backend:install:dev": "cd apps/backend && uv sync --extra dev",
    "backend:test": "cd apps/backend && uv run pytest",
    "backend:format": "cd apps/backend && uv run ruff format src/",
    "backend:lint": "cd apps/backend && uv run ruff check src/",
    "backend:lint:fix": "cd apps/backend && uv run ruff check src/ --fix",
    "deploy:frontend": "cd apps/frontend && vercel --prod",
    "deploy:frontend:preview": "cd apps/frontend && vercel",
    "deploy:backend": "echo 'Deploy backend via Railway/Render dashboard'",
    "deploy:all": "npm run deploy:frontend"
  },
  "keywords": [
    "monorepo",
    "typescript",
    "python",
    "react",
    "fastapi",
    "vite",
    "tailwind",
    "supabase",
    "processa-ai"
  ],
  "author": "Processa AI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}