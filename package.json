{
  "name": "processa-ai-monorepo",
  "version": "1.0.0",
  "description": "Monorepo para o Processa AI - Plataforma de cálculos trabalhistas e IA",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@processa-ai/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "install-all": "npm install --workspaces",
    "web:dev": "npm run dev --workspace=@processa-ai/web",
    "web:build": "npm run build --workspace=@processa-ai/web",
    "api:dev": "npm run dev --workspace=@processa-ai/api",
    "api:build": "npm run build --workspace=@processa-ai/api",
    "types:build": "npm run build --workspace=@processa-ai/types",
    "deploy:web": "cd apps/web && vercel --prod",
    "deploy:web:preview": "cd apps/web && vercel",
    "deploy:api": "cd apps/api && vercel --prod",
    "deploy:api:preview": "cd apps/api && vercel",
    "deploy:all": "npm run deploy:web && npm run deploy:api",
    "deploy:all:preview": "npm run deploy:web:preview && npm run deploy:api:preview"
  },
  "keywords": [
    "monorepo",
    "typescript",
    "react",
    "vite",
    "tailwind",
    "supabase",
    "vercel",
    "processa-ai"
  ],
  "author": "Processa AI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}