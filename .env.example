# ==============================================================================
# Processa AI - Variáveis de Ambiente
# ==============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para rodar
# a aplicação via Docker Compose.
#
# Copie este arquivo para .env e preencha os valores.
# ==============================================================================

# ==============================================================================
# GERAL / COMPARTILHADO
# ==============================================================================
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Supabase (usado por backend, worker e frontend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_OUTPUTS_BUCKET=supabase-outputs

# ------------------------------------------------------------------------------
# Database (conexão direta PostgreSQL para migrations/Alembic)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Redis (fila de jobs compartilhada entre backend e worker)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
JOBS_QUEUE_KEY=jobs
JOB_STATUS_TTL_S=86400

# ==============================================================================
# FRONTEND (Vite/React - porta 5173)
# ==============================================================================
VITE_BACKEND_URL=http://localhost:8000
VITE_INTERNAL_TOKEN=troque-por-um-token-forte
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# ==============================================================================
# BACKEND (FastAPI - porta 8000)
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Internal Auth (token para comunicação frontend -> backend)
# ------------------------------------------------------------------------------
INTERNAL_TOKEN=troque-por-um-token-forte

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Stripe (billing)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx

# ------------------------------------------------------------------------------
# Email (SendGrid)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM=noreply@seudominio.com
ADMIN_EMAIL=admin@seudominio.com

# ------------------------------------------------------------------------------
# Google OAuth (calendar integration)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/office/calendar/callback

# Encryption key para tokens Google
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=sua-chave-fernet-base64

# ------------------------------------------------------------------------------
# n8n Integration (enfileira jobs para o worker)
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://n8n:5678
N8N_CNIS_WORKFLOW_ID=seu-workflow-id
N8N_FILE_FIELD_NAME=data
N8N_AUTH_USER=
N8N_AUTH_PASSWORD=
N8N_TIMEOUT_S=120

# ------------------------------------------------------------------------------
# Webhooks (URL pública para callbacks externos)
# ------------------------------------------------------------------------------
WEBHOOK_BASE_URL=https://api.seudominio.com

# ==============================================================================
# WORKER (Job Processor)
# ==============================================================================
# O worker usa as mesmas variáveis compartilhadas:
# - DATABASE_URL, SUPABASE_*, REDIS_*, N8N_*, GOOGLE_*, ENCRYPTION_KEY
#
# Variável específica do worker:
AI_WORKER_CALLBACK_BASE_URL=http://backend:8000

# ==============================================================================
# N8N (Workflow Engine - porta 5678)
# ==============================================================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
GENERIC_TIMEZONE=America/Sao_Paulo

# n8n Runners
N8N_RUNNERS_AUTH_TOKEN=troque-por-um-token-forte
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=0
