# ==============================================================================
# Processa AI - Variáveis de Ambiente
# ==============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para rodar
# todos os serviços da aplicação via Docker Compose.
# ==============================================================================

# ==============================================================================
# GERAL / COMPARTILHADO
# ==============================================================================
ENVIRONMENT=development

# Supabase (usado por múltiplos serviços)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_OUTPUTS_BUCKET=ai-outputs

# Database (conexão direta para migrations/Alembic)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# GATEWAY (API Gateway - porta 8080)
# ==============================================================================
# Tokens internos para comunicação entre gateway e microserviços
AI_WORKER_INTERNAL_TOKEN=troque-por-um-token-forte
CALC_ENGINE_INTERNAL_TOKEN=troque-por-um-token-forte
OFFICE_API_INTERNAL_TOKEN=troque-por-um-token-forte

# Timeout para chamadas aos microserviços (em segundos)
UPSTREAM_TIMEOUT_S=300

# ==============================================================================
# FRONTEND (Vite/React - porta 5173)
# ==============================================================================
VITE_BACKEND_URL=http://localhost:8000
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# ==============================================================================
# BACKEND (FastAPI - porta 8000)
# ==============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Support / Email
ADMIN_EMAIL=admin@example.com
SENDGRID_API_KEY=sua-chave-sendgrid
SENDGRID_FROM=support@example.com

# AI Worker (chamadas do backend para o worker)
AI_WORKER_BASE_URL=http://localhost:8001
AI_WORKER_TIMEOUT_S=120

# Calc Engine (chamadas do backend para calc-engine)
CALC_ENGINE_BASE_URL=http://localhost:8002
CALC_ENGINE_TIMEOUT_S=30

# Office API (chamadas do backend para office-api)
OFFICE_API_BASE_URL=http://localhost:8003
OFFICE_API_TIMEOUT_S=30

# Storage
AI_DOCUMENTS_BUCKET=ai-documents

# ==============================================================================
# AI WORKER (AI Jobs API - porta 8001)
# ==============================================================================
JOBS_QUEUE_KEY=jobs
JOB_STATUS_TTL_S=86400

# Callback URL (usado pelo worker para notificar a API)
AI_WORKER_CALLBACK_BASE_URL=http://localhost:8001

# ==============================================================================
# N8N (Workflow Engine - porta 5678)
# ==============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
GENERIC_TIMEZONE=America/Sao_Paulo

# n8n Workflows
N8N_BASE_URL=http://localhost:5678
N8N_CNIS_WORKFLOW_ID=seu-workflow-id
N8N_FILE_FIELD_NAME=data
N8N_AUTH_USER=
N8N_AUTH_PASSWORD=
N8N_TIMEOUT_S=120

# n8n Runners
N8N_RUNNERS_AUTH_TOKEN=troque-por-um-token-forte
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=0

# ==============================================================================
# OFFICE API (Gestão de Escritório + Google Calendar - porta 8003)
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/office/calendar/callback

# Encryption (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=sua-chave-fernet-base64

# Webhooks (URL pública para receber notificações do Google)
WEBHOOK_BASE_URL=https://api.seudominio.com
