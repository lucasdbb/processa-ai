# ==============================================================================
# Processa AI - Variáveis de Ambiente
# ==============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para rodar
# a aplicação via Docker Compose.
#
# Copie este arquivo para .env e preencha os valores.
# ==============================================================================

# ==============================================================================
# GERAL / COMPARTILHADO
# ==============================================================================
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Supabase (usado por backend, worker e frontend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ------------------------------------------------------------------------------
# Database (conexão direta PostgreSQL para migrations/Alembic)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# ==============================================================================
# FRONTEND (Vite/React - porta 5173)
# ==============================================================================
VITE_BACKEND_URL=http://localhost:8000
VITE_INTERNAL_TOKEN=troque-por-um-token-forte
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# ==============================================================================
# BACKEND (FastAPI - porta 8000)
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Internal Auth (token para comunicação frontend -> backend)
# ------------------------------------------------------------------------------
INTERNAL_TOKEN=troque-por-um-token-forte

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Stripe (billing)
# Price IDs são gerenciados na tabela billing_plans do banco de dados
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ------------------------------------------------------------------------------
# Email (SendGrid)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM=noreply@seudominio.com
SUPPORT_EMAIL=suporte@seudominio.com

# ------------------------------------------------------------------------------
# Google OAuth (calendar integration)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/office/calendar/google/callback

# Encryption key para tokens Google
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=sua-chave-fernet-base64

# ==============================================================================
# WORKER (Job Processor)
# ==============================================================================
# O worker usa as mesmas variáveis compartilhadas:
# - DATABASE_URL, SUPABASE_*, GOOGLE_*, ENCRYPTION_KEY

# ------------------------------------------------------------------------------
# AI Providers (usados pelo worker para análise de documentos)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
MISTRAL_API_KEY=xxx
LLM_MODEL=gpt-4.1-mini

# Google Gemini
# - Worker: usado para análise de CNIS e jobs de IA
# - Backend: usado para chat jurídico (streaming) e embeddings RAG
GEMINI_API_KEY=sua-gemini-api-key
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENRICHMENT_MODEL=gemini-3.1-flash-lite-preview
