      "parameters": {
        "jsCode": "const cur = $input.first().json;\nconst resumoGerado = cur.output?.[0]?.content?.[0]?.text ?? cur.output?.text ?? '';\n\nreturn [{\n  json: {\n    textoExtraido: $('Extrair Texto (OCR)').item.json.extractedText,\n    resumoGerado\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 300],
      "id": "prepare-audit",
      "name": "Preparar Auditoria"
