    {
      "parameters": {
        "jsCode": "const auditoriaRaw = $input.first().json.output?.[0]?.content?.[0]?.text || $input.first().json.output?.text || '{}';\nlet auditoria = {};\ntry {\n  auditoria = typeof auditoriaRaw === 'string' ? JSON.parse(auditoriaRaw) : auditoriaRaw;\n} catch (e) {\n  auditoria = { aprovado: false, media: 0, scores: {}, structured_summary: {} };\n}\n\nconst state = $('Preparar Auditoria').first().json;\nreturn [{\n  json: {\n    resumoGerado: state.resumoGerado,\n    auditoria,\n    aprovado: auditoria.aprovado === true,\n    media: parseFloat(auditoria.media) || 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3100, 300],
