    {
      "name": "Admin",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número da página (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Itens por página (default: 50, max: 100)"
                },
                {
                  "key": "role",
                  "value": "user",
                  "description": "Filtrar por role (user, admin, premium)",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "user@example.com",
                  "description": "Buscar por email ou nome",
                  "disabled": true
                }
              ]
            },
            "description": "Lista todos os usuários (admin only)"
          },
          "response": []
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"uuid-do-usuario\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/:userId/role",
              "host": ["{{base_url}}"],
              "path": ["api", "users", ":userId", "role"],
              "variable": [
                {
                  "key": "userId",
                  "value": "uuid-do-usuario",
                  "description": "ID do usuário a ser atualizado"
                }
              ]
            },
            "description": "Atualiza role de um usuário (admin only). Roles válidas: user, admin, premium"
          },
          "response": []
        }
      ]
