# API Configuration
# Configurações específicas para o projeto API (backend)

# Supabase Configuration
# Configurações necessárias para conectar com o Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS Configuration
# URLs permitidas para requisições CORS (separadas por vírgula)

# Para desenvolvimento local + produção:
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://processa-ai.vercel.app

# Exemplos de configuração:
# Apenas local: FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Apenas produção: FRONTEND_URL=https://processa-ai.vercel.app
# Misto (recomendado): FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://processa-ai.vercel.app

# Development
NODE_ENV=development

# JWT Configuration (se necessário)
# JWT_SECRET=your_jwt_secret_key