{
  "buildCommand": "npm run type-check",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.1.0",
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/auth/login",
      "destination": "/api/auth/session?action=login"
    },
    {
      "source": "/auth/register",
      "destination": "/api/auth/session?action=register"
    },
    {
      "source": "/auth/refresh",
      "destination": "/api/auth/session?action=refresh"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth/session?action=logout"
    },
    {
      "source": "/auth/logout-all",
      "destination": "/api/auth/session?action=logout-all"
    },
    {
      "source": "/auth/me",
      "destination": "/api/auth/profile"
    },
    {
      "source": "/auth/get-user-details",
      "destination": "/api/auth/profile?details=true"
    },
    {
      "source": "/auth/update-profile",
      "destination": "/api/auth/profile"
    },
    {
      "source": "/auth/upload-avatar",
      "destination": "/api/auth/profile?action=upload-avatar"
    },
    {
      "source": "/auth/list-users",
      "destination": "/api/auth/admin?action=list-users"
    },
    {
      "source": "/auth/update-role",
      "destination": "/api/auth/admin?action=update-role"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["gru1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'none'; style-src 'none'; img-src 'none'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
