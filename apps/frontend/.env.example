# Frontend Configuration
# Configurações específicas para o projeto web (frontend)

# API Configuration
# Para produção, use a URL do seu Backend deployado
VITE_BACKEND_URL=https://your-backend-url.railway.app

# Supabase Configuration (opcional - apenas se usar diretamente no frontend)
# Obtenha suas chaves em: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Development
NODE_ENV=development

# Exemplo para desenvolvimento local:
# VITE_BACKEND_URL=http://localhost:8000
