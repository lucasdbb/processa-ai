{
  "manifest_version": 3,
  "name": "Páginas Salvas — A Nova Advocacia",
  "description": "Salve a página atual com um clique (título, link e nota) e encontre tudo depois, sincronizado entre seus computadores.",
  "version": "1.0.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Salvar esta página",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "favicon",
    "contextMenus"
  ],
  "minimum_chrome_version": "116"
}
