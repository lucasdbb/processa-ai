# ==============================================================================
# Backend (FastAPI) - Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env ou use o .env global na raiz do projeto.
# ==============================================================================

# ==============================================================================
# SERVER
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ==============================================================================
# INTERNAL AUTH
# ==============================================================================
# Token para autenticação de requisições vindas do frontend
INTERNAL_TOKEN=troque-por-um-token-forte

# ==============================================================================
# DATABASE
# ==============================================================================
# Conexão direta PostgreSQL (usado para migrations com Alembic)
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJECTREF.supabase.co:5432/postgres?sslmode=require

# ==============================================================================
# SUPABASE
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key


# ==============================================================================
# CORS
# ==============================================================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# STRIPE (Billing)
# ==============================================================================
# Price IDs são gerenciados na tabela billing_plans do banco de dados
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ==============================================================================
# EMAIL (Brevo)
# ==============================================================================
BREVO_API_KEY=xkeysib-xxx
BREVO_FROM=noreply@seudominio.com
BREVO_FROM_NAME=Contato - Processa AI
EMAIL_LOGO_URL=https://www.processai.app.br/logo_light.png
ADMIN_EMAIL=admin@seudominio.com

# ==============================================================================
# GOOGLE OAUTH (Calendar Integration)
# ==============================================================================
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/office/calendar/google/callback

# Encryption key para tokens Google
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=sua-chave-fernet-base64

# ==============================================================================
# GEMINI (Chat Jurídico + Embeddings RAG)
# ==============================================================================
# API key do Google AI (usada para streaming do chat e embeddings de busca RAG)
GEMINI_API_KEY=sua-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ==============================================================================
# DATAJUD (API Pública CNJ)
# ==============================================================================
# Obrigatório. Obtenha sua chave em: https://datajud-wiki.cnj.jus.br/api-publica
DATAJUD_API_KEY=sua-chave-datajud
