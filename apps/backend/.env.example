# ==============================================================================
# Backend (FastAPI) - Variáveis de Ambiente
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Support / Email
ADMIN_EMAIL=admin@example.com
SENDGRID_API_KEY=sua-chave-sendgrid
SENDGRID_FROM=support@example.com

# Mistral (IA)
MISTRAL_API_KEY=sua-chave-mistral
MISTRAL_CNIS_AGENT_ID=seu-cnis-agent-id
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_S=60

# OpenAI
OPENAI_API_KEY=sua-chave-openai
OPENAI_ASSISTANT_ID=seu-openai-assistant-id
OPENAI_TIMEOUT_S=60

# AI Worker (microserviço interno)
AI_WORKER_BASE_URL=http://localhost:8001
AI_WORKER_INTERNAL_TOKEN=troque-por-um-token-forte
AI_WORKER_TIMEOUT_S=120

# Calc Engine (microserviço interno)
CALC_ENGINE_BASE_URL=http://localhost:8002
CALC_ENGINE_INTERNAL_TOKEN=troque-por-um-token-forte
CALC_ENGINE_TIMEOUT_S=30

# Office API (microserviço interno)
OFFICE_API_BASE_URL=http://localhost:8003
OFFICE_API_INTERNAL_TOKEN=troque-por-um-token-forte
OFFICE_API_TIMEOUT_S=30
