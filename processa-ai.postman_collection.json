{
  "info": {
    "name": "Processa AI",
    "description": "Collection completa para testes da plataforma Processa AI - Arquitetura de Microserviços",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ai_worker_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "calc_engine_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "office_worker_url",
      "value": "http://localhost:8003",
      "type": "string"
    },
    {
      "key": "n8n_url",
      "value": "http://localhost:5678",
      "type": "string"
    },
    {
      "key": "supabase_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ai_worker_internal_token",
      "value": "dev-secret-token",
      "type": "string"
    },
    {
      "key": "n8n_user",
      "value": "",
      "type": "string"
    },
    {
      "key": "n8n_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_pdf_url",
      "value": "https://storage.supabase.co/v1/object/public/inputs/test-cnis.pdf",
      "type": "string"
    },
    {
      "key": "test_user_id",
      "value": "test-user-123",
      "type": "string"
    },
    {
      "key": "test_client_id",
      "value": "test-client-456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Services",
      "description": "Microserviços da plataforma Processa AI",
      "item": [
        {
          "name": "API Gateway",
          "description": "Gateway principal - Frontend se comunica apenas com este serviço (porta 8080)",
          "item": [
            {
              "name": "Health Check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{api_gateway_url}}/health",
                  "host": ["{{api_gateway_url}}"],
                  "path": ["health"]
                }
              },
              "response": []
            },
            {
              "name": "CNIS - Upload e Análise (Multipart)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 202) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('job_id', response.job_id);",
                      "    console.log('Job ID salvo:', response.job_id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{supabase_access_token}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "Arquivo PDF do CNIS"
                    },
                    {
                      "key": "client_id",
                      "value": "{{test_client_id}}",
                      "type": "text"
                    },
                    {
                      "key": "store_pdf",
                      "value": "true",
                      "type": "text"
                    },
                    {
                      "key": "signed_url_expires_in",
                      "value": "600",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{api_gateway_url}}/api/ai/cnis-analysis",
                  "host": ["{{api_gateway_url}}"],
                  "path": ["api", "ai", "cnis-analysis"]
                },
                "description": "Upload multipart de PDF do CNIS. Frontend usa este endpoint."
              },
              "response": []
            },
            {
              "name": "CNIS - Consultar Status do Job",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{supabase_access_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{api_gateway_url}}/api/ai/jobs/{{job_id}}",
                  "host": ["{{api_gateway_url}}"],
                  "path": ["api", "ai", "jobs", "{{job_id}}"]
                },
                "description": "Polling do status do job através do gateway"
              },
              "response": []
            },
            {
              "name": "CNIS - Histórico de Análises",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{supabase_access_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{api_gateway_url}}/api/ai/analyses/history?limit=50&offset=0",
                  "host": ["{{api_gateway_url}}"],
                  "path": ["api", "ai", "analyses", "history"],
                  "query": [
                    {
                      "key": "limit",
                      "value": "50"
                    },
                    {
                      "key": "offset",
                      "value": "0"
                    }
                  ]
                },
                "description": "Lista histórico de análises do usuário (input + output)"
              },
              "response": []
            },
            {
              "name": "CNIS - Download de Documento",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const response = pm.response.json();",
                      "    console.log('Signed URL:', response.signed_url);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{supabase_access_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{api_gateway_url}}/api/ai/documents/{{document_id}}/download",
                  "host": ["{{api_gateway_url}}"],
                  "path": ["api", "ai", "documents", "{{document_id}}", "download"]
                },
                "description": "Gera URL assinada para download de documento (input ou output)"
              },
              "response": []
            }
          ]
        },
        {
          "name": "AI Worker",
          "description": "Serviço de processamento de IA (porta 8001) - Uso interno via Gateway",
          "item": [
            {
              "name": "Health Check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{ai_worker_url}}/health",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["health"]
                }
              },
              "response": []
            },
            {
              "name": "CNIS - Upload Multipart (Interno)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 202) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('job_id', response.job_id);",
                      "    console.log('Job ID salvo:', response.job_id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": [],
                      "description": "Arquivo PDF do CNIS"
                    },
                    {
                      "key": "user_id",
                      "value": "{{test_user_id}}",
                      "type": "text"
                    },
                    {
                      "key": "client_id",
                      "value": "{{test_client_id}}",
                      "type": "text"
                    },
                    {
                      "key": "store_pdf",
                      "value": "true",
                      "type": "text"
                    },
                    {
                      "key": "signed_url_expires_in",
                      "value": "600",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/analyses/cnis-upload",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "analyses", "cnis-upload"]
                },
                "description": "Upload multipart direto no AI Worker (gateway faz proxy deste endpoint)"
              },
              "response": []
            },
            {
              "name": "CNIS - Enfileirar Análise (Legacy - file_url)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 202) {",
                      "    const response = pm.response.json();",
                      "    pm.collectionVariables.set('job_id', response.job_id);",
                      "    console.log('Job ID salvo:', response.job_id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"file_url\": \"{{test_pdf_url}}\",\n  \"user_id\": \"{{test_user_id}}\",\n  \"client_id\": \"{{test_client_id}}\",\n  \"store_pdf\": true,\n  \"signed_url_expires_in\": 600\n}"
                },
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/analyses/cnis",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "analyses", "cnis"]
                },
                "description": "Modo legado com file_url (retrocompatibilidade)"
              },
              "response": []
            },
            {
              "name": "CNIS - Consultar Status do Job",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/jobs/{{job_id}}",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "jobs", "{{job_id}}"]
                },
                "description": "Consulta status do job no AI Worker"
              },
              "response": []
            },
            {
              "name": "CNIS - Callback de Progresso (n8n → AI Worker)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"progress\": 50,\n  \"message\": \"Teste de callback manual\"\n}"
                },
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/jobs/progress",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "jobs", "progress"]
                },
                "description": "Endpoint que o n8n chama para atualizar progresso"
              },
              "response": []
            },
            {
              "name": "CNIS - Histórico de Análises",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Supabase-Access-Token",
                    "value": "{{supabase_access_token}}",
                    "type": "text",
                    "description": "Token do usuário para filtrar histórico"
                  }
                ],
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/analyses/history?limit=50&offset=0",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "analyses", "history"],
                  "query": [
                    {
                      "key": "limit",
                      "value": "50"
                    },
                    {
                      "key": "offset",
                      "value": "0"
                    }
                  ]
                },
                "description": "Lista histórico de análises do usuário"
              },
              "response": []
            },
            {
              "name": "CNIS - Download de Documento",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const response = pm.response.json();",
                      "    console.log('Signed URL:', response.signed_url);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Internal-Token",
                    "value": "{{ai_worker_internal_token}}",
                    "type": "text"
                  },
                  {
                    "key": "X-Supabase-Access-Token",
                    "value": "{{supabase_access_token}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{ai_worker_url}}/api/v1/ai/documents/{{document_id}}/download",
                  "host": ["{{ai_worker_url}}"],
                  "path": ["api", "v1", "ai", "documents", "{{document_id}}", "download"]
                },
                "description": "Gera URL assinada para download de documento"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Calc Engine",
          "description": "Serviço de cálculos trabalhistas (porta 8002)",
          "item": [
            {
              "name": "Health Check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{calc_engine_url}}/health",
                  "host": ["{{calc_engine_url}}"],
                  "path": ["health"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Office Worker",
          "description": "Serviço de processos e calendário (porta 8003)",
          "item": [
            {
              "name": "Health Check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{office_worker_url}}/health",
                  "host": ["{{office_worker_url}}"],
                  "path": ["health"]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Testing & Debug",
      "description": "Endpoints para testes diretos (bypass do gateway)",
      "item": [
        {
          "name": "n8n - CNIS Analyzer Webhook Direto",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{n8n_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{n8n_password}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "type": "file",
                  "src": [],
                  "description": "Arquivo PDF do CNIS (campo fixo 'data')"
                }
              ]
            },
            "url": {
              "raw": "{{n8n_url}}/webhook/cnis-analyzer-v3?job_id=ai:test-{{$randomUUID}}&callback_url={{ai_worker_url}}/api/v1/ai/jobs/progress",
              "host": ["{{n8n_url}}"],
              "path": ["webhook", "cnis-analyzer-v3"],
              "query": [
                {
                  "key": "job_id",
                  "value": "ai:test-{{$randomUUID}}",
                  "description": "Job ID (namespace ai:uuid)"
                },
                {
                  "key": "callback_url",
                  "value": "{{ai_worker_url}}/api/v1/ai/jobs/progress",
                  "description": "URL para n8n enviar updates de progresso"
                }
              ]
            },
            "description": "Chamada DIRETA ao webhook do n8n (bypass do AI Worker). Útil para debug do fluxo n8n.\n\n**IMPORTANTE:**\n- Campo de arquivo deve ser 'data' (fixo)\n- Query params: job_id e callback_url\n- Autenticação Basic Auth (se configurada no n8n)"
          },
          "response": []
        }
      ]
    }
  ]
}
